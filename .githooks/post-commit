#!/usr/bin/env python3
"""post-commit hook: post a comment to the linked task via API."""
import json
import os
import re
import subprocess
import sys
import urllib.request


def main():
    api_url = os.environ.get("TOOL_API_URL", "").rstrip("/")
    api_key = os.environ.get("TOOL_API_KEY", "")
    user_id = os.environ.get("TOOL_USER_ID", "")

    if not api_url or not api_key or not user_id:
        print("[post-commit] TOOL_API_URL / TOOL_API_KEY / TOOL_USER_ID not set; skipping.", file=sys.stderr)
        return

    commit_id = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    msg = subprocess.check_output(["git", "log", "-1", "--pretty=%B"], text=True)

    # Match "Task: 123" or "Task: [123](https://...)"
    m = re.search(r"Task: \[?(\d+)\]?", msg)
    if not m:
        return

    task_id = int(m.group(1))
    description = f"commit: {commit_id}"

    payload = json.dumps({
        "author": int(user_id),
        "task": task_id,
        "description": description,
    }).encode()

    req = urllib.request.Request(
        f"{api_url}/task_app/comments/",
        data=payload,
        headers={
            "X-API-Key": api_key,
            "Content-Type": "application/json",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(req) as resp:
            print(f"[post-commit] Comment posted to Task {task_id} (HTTP {resp.status})")
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        print(f"[post-commit] API error {e.code}: {body}", file=sys.stderr)
    except Exception as e:
        print(f"[post-commit] Failed to post comment: {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
