#!/bin/bash
# post-commit: Post a comment on the task with a linked commit ID.
# Requires TOOL_API_URL, TOOL_API_KEY, and TASK_URL to be set (via direnv).

set -euo pipefail

# Load direnv if available
if command -v direnv &>/dev/null; then
  eval "$(direnv export bash 2>/dev/null)" || true
fi

TASK_URL="${TASK_URL:-}"
TOOL_API_URL="${TOOL_API_URL:-}"
TOOL_API_KEY="${TOOL_API_KEY:-}"

if [[ -z "$TOOL_API_URL" || -z "$TOOL_API_KEY" ]]; then
  exit 0
fi

# Extract task ID from the last commit message (Task: <id>)
COMMIT_MSG=$(git log -1 --format="%B")
TASK_ID=$(echo "$COMMIT_MSG" | grep -oP '(?<=Task:\s)(\d+)' | head -1)

if [[ -z "$TASK_ID" ]]; then
  exit 0
fi

# Get commit SHA
COMMIT_SHA=$(git rev-parse HEAD)

# Get git URL from project associated with the task
# Fetch the task to get the project ID
TASK_JSON=$(curl -s \
  "${TOOL_API_URL}task_app/tasks/${TASK_ID}/" \
  -H "X-API-Key: ${TOOL_API_KEY}")

PROJECT_ID=$(echo "$TASK_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin).get('project',''))" 2>/dev/null || true)

if [[ -z "$PROJECT_ID" ]]; then
  exit 0
fi

PROJECT_JSON=$(curl -s \
  "${TOOL_API_URL}task_app/projects/${PROJECT_ID}/" \
  -H "X-API-Key: ${TOOL_API_KEY}")

GIT_URL=$(echo "$PROJECT_JSON" | python3 -c "import sys,json; d=json.load(sys.stdin); print((d.get('git_url') or '').rstrip('/'))" 2>/dev/null || true)

if [[ -z "$GIT_URL" ]]; then
  # Fallback: post commit SHA without link
  COMMENT_TEXT="対応コミット: \`${COMMIT_SHA}\`"
else
  COMMIT_LINK="${GIT_URL}/commit/${COMMIT_SHA}"
  COMMENT_TEXT="対応コミット: [${COMMIT_SHA}](${COMMIT_LINK})"
fi

# Get the task's assignee to use as comment author
AUTHOR_ID=$(echo "$TASK_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin).get('assignee',''))" 2>/dev/null || true)

if [[ -z "$AUTHOR_ID" ]]; then
  exit 0
fi

curl -s -X POST \
  "${TOOL_API_URL}task_app/comments/" \
  -H "X-API-Key: ${TOOL_API_KEY}" \
  -H "Content-Type: application/json" \
  -d "$(python3 -c "
import json, sys
print(json.dumps({
  'author': int('${AUTHOR_ID}'),
  'description': '${COMMENT_TEXT}'.replace('\\\\', '\\\\\\\\'),
  'task': int('${TASK_ID}'),
}))
")" > /dev/null

exit 0
