#!/bin/bash
# commit-msg: Enforce commit message format and rewrite Task: <id> to a Markdown link.
#
# Expected format:
#   <kind>: <Summary starting with uppercase> #<task_id>
#
#   - Detail line (80 chars max)
#
#   Task: <task_id>
#
# This hook rewrites the last line from:
#   Task: <id>
# to:
#   Task: [<id>](<TASK_URL>/<id>/)

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Load direnv if available
if command -v direnv &>/dev/null; then
  eval "$(direnv export bash 2>/dev/null)" || true
fi

TASK_URL="${TASK_URL:-}"

# --- Validate format ---

FIRST_LINE=$(echo "$COMMIT_MSG" | head -1)

# kind: Summary #task_id
if ! echo "$FIRST_LINE" | grep -qP '^(Ftr|Fix|Eta): [A-Z].{0,48} #\d+$'; then
  echo "commit-msg: First line must match '<kind>: <Summary starting with uppercase> #<task_id>'" >&2
  echo "  Got: $FIRST_LINE" >&2
  echo "  Valid kinds: Ftr, Fix, Eta" >&2
  exit 1
fi

# Check ASCII-only on first line
if echo "$FIRST_LINE" | grep -qP '[^\x00-\x7F]'; then
  echo "commit-msg: First line must be ASCII only." >&2
  exit 1
fi

# Check Task: line exists
if ! echo "$COMMIT_MSG" | grep -qP '^Task: \d+$'; then
  echo "commit-msg: Last meaningful line must be 'Task: <task_id>'" >&2
  exit 1
fi

# --- Rewrite Task: line to Markdown link ---

if [[ -n "$TASK_URL" ]]; then
  # Rewrite "Task: <id>" -> "Task: [<id>](<TASK_URL>/<id>/)"
  python3 - "$COMMIT_MSG_FILE" "$TASK_URL" <<'EOF'
import re
import sys

commit_msg_file = sys.argv[1]
task_url = sys.argv[2].rstrip('/')

with open(commit_msg_file, 'r') as f:
    content = f.read()

def replace_task_line(m):
    task_id = m.group(1)
    return f"Task: [{task_id}]({task_url}/{task_id}/)"

new_content = re.sub(r'^Task: (\d+)$', replace_task_line, content, flags=re.MULTILINE)

with open(commit_msg_file, 'w') as f:
    f.write(new_content)
EOF
fi

exit 0
