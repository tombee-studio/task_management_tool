// Task Management DSL — Cypher-inspired grammar
//
// Cypher influences:
//   -> notation for directed relationships (LINK, PARENT)
//   keyword-driven imperative statements (like Cypher's CREATE / SET)
//
// Supported commands:
//   LINK    <src>  -> <dst>          create a bidirectional relation
//   TAG     <id>   <name>            assign a label  (future)
//   PARENT  <child> -> <parent>      set hierarchy   (future)
//   ASSIGN  <id>   TO <username>     set assignee
//   EVENT   <task_id> <event_id>     link task to event

start : statement*

?statement : link_stmt
           | tag_stmt
           | parent_stmt
           | assign_stmt
           | event_stmt

// LINK 1 -> 2
// Mirrors Cypher's CREATE (a)-[:RELATES]->(b) but concise
link_stmt   : "LINK"i   INTEGER "->" INTEGER

// TAG 1 "urgent"  |  TAG 1 urgent
// Mirrors Cypher's SET n:Label
tag_stmt    : "TAG"i    INTEGER name_or_string

// PARENT 1 -> 2
// Mirrors Cypher's CREATE (a)-[:CHILD_OF]->(b)
parent_stmt : "PARENT"i INTEGER "->" INTEGER

// ASSIGN 1 TO "alice"  |  ASSIGN 1 TO alice
// Mirrors Cypher's SET n.assignee = value
assign_stmt : "ASSIGN"i INTEGER "TO"i name_or_string

// EVENT 1 2
// Link task 1 to event 2
event_stmt  : "EVENT"i  INTEGER INTEGER

// Values may be bare identifiers or double-quoted strings
name_or_string : NAME | ESCAPED_STRING

INTEGER        : /\d+/
NAME           : /[A-Za-z_][A-Za-z0-9_\-]*/

%import common.ESCAPED_STRING
%import common.WS_INLINE
%import common.NEWLINE
%ignore WS_INLINE
%ignore NEWLINE
